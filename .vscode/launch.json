{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "WhisperTyper",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": false
        },
        {
            "name": "WhisperTyper (no console)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "internalConsole",
            "cwd": "${workspaceFolder}"
        }
    ]
}
